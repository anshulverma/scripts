#!/usr/bin/env bash
# reposync: sync every git repo directly under the workspace with its remote.
# shellcheck disable=SC2034,SC2317  # later tasks use the per-repo globals and add_action; trap-only functions
set -u

export GIT_TERMINAL_PROMPT=0 GIT_EDITOR=true GIT_MERGE_AUTOEDIT=no
[ -n "${GIT_SSH_COMMAND:-}" ] || export GIT_SSH_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=30'

# run-level state
WS="" WS_ARG="" DIRTY_MODE=skip DRY_RUN=0
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/reposync
TO=""
if command -v timeout >/dev/null 2>&1; then TO=timeout
elif command -v gtimeout >/dev/null 2>&1; then TO=gtimeout; fi
CLAUDE_BIN=$(command -v claude 2>/dev/null || true)
HAVE_LOCK=0 CHILD="" RC=0 FAILED=0 IN_REPO=0 FROM_SIGNAL=0
# per-repo state (see reset_repo_state)
REPO_DIR="" REPO_NAME="" B="" R="" PRE="" RS="" HAD_R=0 STATE="" SNAP="" SNAP_TAKEN=0
SAVED_TREE="" STASH_SHA="" ADDED=0 U="" ACTIONS="" NOTE="" RESULT=""
TMPD=$(mktemp -d) || { echo "reposync: cannot create temp dir" >&2; exit 2; }
OUTF=$TMPD/out ERRF=$TMPD/err LASTERR=$TMPD/last.err
: >"$OUTF"; : >"$ERRF"; : >"$LASTERR"

usage() {
  cat <<'USAGE'
usage: reposync [--dirty=skip|commit|keep] [--dry-run] [--workspace DIR] [-h|--help]

Sync every git repo directly under the workspace with its remote.

  --dirty=skip|commit|keep  dirty working trees: skip (default), commit them, or keep (stash around the merge)
  --dry-run                 fetch only; report what would happen
  --workspace DIR           workspace directory
  -h, --help                show this help

Workspace resolution order: --workspace DIR, $WORKSPACE_DIR,
~/.config/dotsync2/constants.env, then $HOME/workspace.

Exit codes:
  0    every repo ok or skipped
  1    any repo failed, or a leftover warning
  2    usage or workspace error
  3    another run holds the lock
  130  interrupted (INT)
  143  terminated (TERM/HUP)
USAGE
}

die_usage() { echo "reposync: $1" >&2; usage >&2; exit 2; }

parse_args() {
  while [ $# -gt 0 ]; do
    case $1 in
      -h|--help) usage; exit 0 ;;
      --dirty=skip|--dirty=commit|--dirty=keep) DIRTY_MODE=${1#--dirty=} ;;
      --dirty=*) die_usage "bad --dirty value: ${1#--dirty=}" ;;
      --dry-run) DRY_RUN=1 ;;
      --workspace)
        { [ $# -ge 2 ] && [ -n "$2" ]; } || die_usage "--workspace needs a directory"
        WS_ARG=$2; shift ;;
      *) die_usage "unknown argument: $1" ;;
    esac
    shift
  done
}

resolve_workspace() {
  local f
  if [ -n "$WS_ARG" ]; then
    WS=$WS_ARG
  else
    if [ -z "${WORKSPACE_DIR:-}" ]; then
      f=$HOME/.config/dotsync2/constants.env
      # shellcheck source=/dev/null
      [ -f "$f" ] && . "$f"
    fi
    WS=${WORKSPACE_DIR:-$HOME/workspace}
  fi
  [ -d "$WS" ] || { echo "reposync: workspace not found: $WS" >&2; exit 2; }
}

acquire_lock() {
  local pid
  mkdir -p "$STATE_DIR" || { echo "reposync: cannot create $STATE_DIR" >&2; exit 2; }
  if ! mkdir "$STATE_DIR/lock" 2>/dev/null; then
    pid=$(cat "$STATE_DIR/lock/pid" 2>/dev/null || true)
    if [ -z "$pid" ] || kill -0 "$pid" 2>/dev/null; then
      echo "reposync: another run (pid ${pid:-?}) holds the lock" >&2
      exit 3
    fi
    rm -rf "$STATE_DIR/lock"
    if ! mkdir "$STATE_DIR/lock" 2>/dev/null; then
      echo "reposync: another run (pid ?) holds the lock" >&2
      exit 3
    fi
  fi
  echo $$ >"$STATE_DIR/lock/pid"
  HAVE_LOCK=1
}

release_lock() { [ "$HAVE_LOCK" = 1 ] && rm -rf "$STATE_DIR/lock"; HAVE_LOCK=0; }

# run_child INFILE CMD...: background + wait so traps fire promptly; sets RC.
run_child() {
  local infile=$1
  shift
  "$@" >"$OUTF" 2>"$LASTERR" <"$infile" &
  CHILD=$!
  wait "$CHILD"
  RC=$?
  CHILD=""
  cat "$LASTERR" >>"$ERRF"
  cat "$LASTERR" >&2
}

git_net() {
  if [ -n "$TO" ]; then run_child /dev/null "$TO" -k 10 300 git "$@"
  else run_child /dev/null git "$@"; fi
}

reset_repo_state() {
  B="" R="" PRE="" RS="" HAD_R=0 STATE="" SNAP="" SNAP_TAKEN=0
  SAVED_TREE="" STASH_SHA="" ADDED=0 U="" ACTIONS="" NOTE="" RESULT=""
}

# g ARGS...: git in the current repo, stdin from /dev/null.
g() { git -C "$REPO_DIR" "$@" </dev/null; }

add_action() {
  case "+$ACTIONS+" in *"+$1+"*) return ;; esac
  ACTIONS=${ACTIONS:+$ACTIONS+}$1
}

# emit_row RESULT: one row per repo; dry-run prefixes the action with would- and adds the state column.
emit_row() {
  local act=${ACTIONS:-none} st=$STATE
  case $1 in failed:*) FAILED=1 ;; esac
  if [ "$DRY_RUN" = 1 ]; then
    [ -n "$ACTIONS" ] && act=would-$ACTIONS
    case $1 in skipped:dirty) st=dirty ;; skipped:*|failed:*) st=$1 ;; esac
    printf '%s\t%s\t%s\t%s\t%s\n' "$REPO_NAME" "${B:--}" "$act" "$1" "$st"
  else
    printf '%s\t%s\t%s\t%s\n' "$REPO_NAME" "${B:--}" "$act" "$1"
  fi
}

is_repo() {
  local top phys
  [ "$(g rev-parse --is-inside-work-tree 2>/dev/null)" = true ] || return 1
  top=$(g rev-parse --show-toplevel 2>/dev/null) || return 1
  phys=$(cd -P "$REPO_DIR" 2>/dev/null && pwd -P) || return 1
  [ "$top" = "$phys" ]
}

# gpath NAME: absolute path of `git rev-parse --git-path NAME` (git prints it relative to the repo).
gpath() {
  local p
  p=$(g rev-parse --git-path "$1" 2>/dev/null) || return 1
  case $p in /*) ;; *) p=$REPO_DIR/$p ;; esac
  printf '%s\n' "$p"
}

# skip_reason: echo the first matching §7.1 skip reason (without "skipped:"), or nothing.
skip_reason() {
  local n p merge remote
  g config --get remote.origin.url >/dev/null 2>&1 || { echo no-origin; return; }
  [ -n "$B" ] || { echo detached-head; return; }
  g rev-parse -q --verify HEAD >/dev/null 2>&1 || { echo no-commits; return; }
  for n in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG rebase-merge rebase-apply; do
    p=$(gpath "$n")
    [ -e "$p" ] && { echo in-progress-op; return; }
  done
  [ -z "$(g ls-files -u 2>/dev/null)" ] || { echo in-progress-op; return; }
  if merge=$(g config --get "branch.$B.merge" 2>/dev/null); then
    remote=$(g config --get "branch.$B.remote" 2>/dev/null)
    { [ "$remote" = origin ] && [ "$merge" = "refs/heads/$B" ]; } || { echo upstream-mismatch; return; }
  fi
  if [ "$DIRTY_MODE" = skip ] && [ -n "$(g status --porcelain --untracked-files=normal 2>/dev/null)" ]; then
    echo dirty
  fi
}

# fetch_repo: §7.1 fetch; returns 1 with RESULT set on fetch failure or upstream-gone.
fetch_repo() {
  local fa=--prune
  [ "$DRY_RUN" = 1 ] && fa=--no-prune
  git_net -C "$REPO_DIR" fetch "$fa" origin
  if [ "$RC" != 0 ]; then RESULT=failed:fetch; return 1; fi
  RS=$(g rev-parse -q --verify "$R" 2>/dev/null) && return 0
  RS=""
  if g config --get "branch.$B.merge" >/dev/null 2>&1; then :
  elif [ "$HAD_R" = 1 ]; then
    if [ "$DRY_RUN" != 1 ]; then
      g config "branch.$B.merge" "refs/heads/$B" && g config "branch.$B.remote" origin
    fi
  else
    return 0  # no upstream, R never existed: new branch
  fi
  RESULT=skipped:upstream-gone
  return 1
}

# classify: sets STATE (§7.2); returns 1 with RESULT=failed:classify if rev-list fails.
classify() {
  local c a b
  if [ -z "$RS" ]; then STATE=no-upstream; return 0; fi
  c=$(g rev-list --left-right --count "HEAD...$R") || { RESULT=failed:classify; return 1; }
  read -r a b <<EOC
$c
EOC
  if [ "$a" = 0 ] && [ "$b" = 0 ]; then STATE=up-to-date
  elif [ "$b" = 0 ]; then STATE=ahead
  elif [ "$a" = 0 ]; then STATE=behind
  else STATE=diverged; fi
}

# zhex: NUL-delimited names on stdin → one line per name, its bytes as space-separated hex ("61 2f 62").
# Exact for any name (quotes, backslashes, newlines, non-ASCII) yet line-oriented, so awk/sort/variables can hold it.
zhex() { od -An -v -tx1 | LC_ALL=C awk '{ for (i = 1; i <= NF; i++) if ($i == "00") { print r; r = "" } else r = (r == "" ? $i : r " " $i) }'; }
# unhex HEXLINE VAR: decode one zhex line into VAR (printf -v keeps trailing newlines).
unhex() { printf -v "$2" '%b' "\\x${1// /\\x}"; }

# untracked: untracked non-ignored paths as sorted zhex lines (SNAP and, in keep mode, U use this format).
untracked() { g ls-files -z --others --exclude-standard | zhex | LC_ALL=C sort; }

# ignored_guard: §7.3; on collision (or a failing git command) restore, set RESULT, return 1.
ignored_guard() {
  local p=$TMPD/guard.p i=$TMPD/guard.i hits
  if ! g diff -z --no-renames --name-only --diff-filter=d "HEAD...$RS" >"$p.z" \
    || ! g ls-files -z --others --ignored --exclude-standard >"$i.z"; then
    RESULT=failed:would-overwrite-ignored; restore; return 1
  fi
  zhex <"$p.z" >"$p"
  zhex <"$i.z" >"$i"
  [ "$DIRTY_MODE" = keep ] && [ -n "$U" ] && printf '%s\n' "$U" >>"$i"
  [ -s "$p" ] && [ -s "$i" ] || return 0
  # Raw names compared as zhex lines; "/" is the token 2f. Collision: p = i, i under p/, or p under i/.
  # Hits are printed with non-printable bytes and backslash as \ooo so the row stays one line.
  hits=$(LC_ALL=C awk '
    function show(s,   n, t, k, v, o, x) { x = "0123456789abcdef"; n = split(s, t, " "); o = ""
      for (k = 1; k <= n; k++) { v = (index(x, substr(t[k], 1, 1)) - 1) * 16 + index(x, substr(t[k], 2, 1)) - 1
        o = o ((v >= 32 && v < 127 && v != 92) ? sprintf("%c", v) : sprintf("\\%03o", v)) }
      return o }
    NR == FNR { P[$0] = 1; n = split($0, a, " 2f "); s = a[1]
                for (k = 2; k <= n; k++) { A[s] = 1; s = s " 2f " a[k] }; next }
    ($0 in P) || ($0 in A) { print show($0); next }
    { n = split($0, a, " 2f "); s = a[1]
      for (k = 2; k <= n; k++) { if (s in P) { print show($0); next }; s = s " 2f " a[k] } }' "$p" "$i" | LC_ALL=C sort -u | tr '\n' ' ')
  [ -z "$hits" ] && return 0
  RESULT="failed:would-overwrite-ignored: ${hits% }"
  restore
  return 1
}

# rescue_untracked DIR: §7.6 step 1. Move (never delete, never overwrite) every untracked path not in SNAP into DIR.
rescue_untracked() {
  local h p dir=$1 dest n moved=0
  printf '%s\n' "$SNAP" >"$TMPD/snap"
  untracked >"$TMPD/now"
  LC_ALL=C awk 'NR == FNR { S[$0] = 1; next } $0 != "" && !($0 in S)' "$TMPD/snap" "$TMPD/now" >"$TMPD/move"
  while IFS= read -r h; do
    unhex "$h" p
    dest=$dir/$p n=0
    while [ "$n" -lt 100 ]; do
      mkdir -p "${dest%/*}" && mv -n "$REPO_DIR/$p" "$dest" 2>/dev/null
      if [ ! -e "$REPO_DIR/$p" ] && [ ! -L "$REPO_DIR/$p" ]; then moved=1; break; fi
      n=$((n + 1)) dest=$dir/$p.$n
    done
  done <"$TMPD/move"
  [ "$moved" = 1 ] && NOTE="${NOTE:+$NOTE; }untracked files moved to $dir"
  return 0
}

# save_tracked DIR: before a reset --hard, save uncommitted tracked changes (index + worktree vs HEAD) as
# DIR/tracked.patch (tracked.patch.N if taken; never overwrite). Returns 1 if they could not be saved.
save_tracked() {
  local f=$1/tracked.patch n=0 t=$TMPD/tracked.patch
  g diff --binary --no-color --no-ext-diff --no-textconv --src-prefix=a/ --dst-prefix=b/ HEAD >"$t" || return 1
  [ -s "$t" ] || return 0
  mkdir -p "$1" || return 1
  until (set -C; cat "$t" >"$f") 2>/dev/null; do
    n=$((n + 1)) f=$1/tracked.patch.$n
    [ "$n" -lt 100 ] || return 1
  done
  NOTE="${NOTE:+$NOTE; }tracked changes saved to $f"
}

# assert_clean_and_snap: §7.3; dirty → restore, RESULT=failed:not-clean, return 1.
assert_clean_and_snap() {
  if [ -n "$(g status --porcelain --untracked-files=normal)" ]; then
    RESULT=failed:not-clean; restore; return 1
  fi
  SNAP=$(untracked)
  SNAP_TAKEN=1
}

# do_merge: §7.4 (STATE behind|diverged); 0 merged, 1 failed (RESULT set, restore run).
do_merge() {
  if [ "$STATE" = behind ]; then
    run_child /dev/null git -C "$REPO_DIR" merge --ff-only "$R"
  else
    run_child /dev/null git -C "$REPO_DIR" -c merge.conflictStyle=zdiff3 merge --no-ff --no-edit "$R"
  fi
  if [ "$RC" = 0 ]; then
    add_action merged
    if [ "$STATE" = behind ]; then PRE=$(g rev-parse HEAD); SNAP=""; SNAP_TAKEN=0; fi
    return 0
  fi
  if [ -n "$(g diff --name-only --diff-filter=U)" ]; then
    claude_resolve merge || return 1
    add_action merged
    return 0
  fi
  RESULT=failed:merge
  [ -s "$LASTERR" ] && RESULT="failed:merge: $(head -n 1 "$LASTERR")"
  restore
  return 1
}

# do_push [-u]: §7.5 incl. the single retry on a non-fast-forward rejection; 0 pushed, 1 failed.
do_push() {
  local u=${1:-} retried=0
  while :; do
    if ! g merge-base --is-ancestor "$PRE" HEAD \
      || { [ -n "$RS" ] && ! g merge-base --is-ancestor "$RS" HEAD; }; then
      RESULT=failed:ancestry; restore; return 1
    fi
    PRE=$(g rev-parse HEAD) SNAP="" SNAP_TAKEN=0
    git_net -C "$REPO_DIR" push ${u:+"$u"} origin "HEAD:refs/heads/$B"
    if [ "$RC" = 0 ]; then
      [ -n "$u" ] && add_action set-upstream
      add_action pushed
      return 0
    fi
    if ! grep -Eq '^ ! \[rejected\] .*\((fetch first|non-fast-forward)\)$' "$LASTERR"; then
      RESULT=failed:push; restore; return 1
    fi
    if [ "$retried" = 1 ]; then RESULT=failed:push-rejected; restore; return 1; fi
    retried=1
    git_net -C "$REPO_DIR" fetch --prune origin
    if [ "$RC" != 0 ]; then RESULT=failed:fetch; restore; return 1; fi
    RS=$(g rev-parse -q --verify "$R") || { RS=""; RESULT=failed:push-rejected; restore; return 1; }
    PRE=$(g rev-parse HEAD)
    classify || { restore; return 1; }
    case $STATE in
      behind|diverged) { ignored_guard && assert_clean_and_snap && do_merge; } || return 1 ;;
    esac
  done
}

# restore [nokeep]: §7.6 steps 0-3 and 5; step 4 is keep_restore (skipped with nokeep, §8.2).
# Overrides RESULT only on a failed post-condition.
restore() {
  local skip=0 p rdir
  [ -n "$PRE" ] || return 0
  rdir=$STATE_DIR/rescue/$REPO_NAME/$(date -u +%Y-%m-%dT%H:%M:%SZ)
  if [ "$DIRTY_MODE" = commit ] && [ "$ADDED" = 1 ]; then
    if [ "$(g rev-parse HEAD)" != "$PRE" ]; then PRE=$(g rev-parse HEAD); ADDED=0
    else g read-tree "$SAVED_TREE"; skip=1; fi
  fi
  if [ "$skip" = 0 ]; then
    [ "$SNAP_TAKEN" = 1 ] && rescue_untracked "$rdir"
    g rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && g merge --abort
    p=0
    if [ "$(g symbolic-ref -q HEAD)" != "refs/heads/$B" ]; then g symbolic-ref HEAD "refs/heads/$B"; p=1; fi
    if [ "$p" = 1 ] || [ "$(g rev-parse HEAD)" != "$PRE" ]; then
      if [ "$SNAP_TAKEN" = 1 ]; then save_tracked "$rdir" && g reset -q --hard "$PRE"; else g reset -q "$PRE"; fi
    elif [ "$SNAP_TAKEN" = 1 ] && [ -n "$(g status --porcelain --untracked-files=no)" ]; then
      # the tree was clean at SNAP: tracked edits made since (claude outside the conflicted set, which merge --abort
      # keeps, or the user during the run) are saved as a patch, then undone. Unsaveable → no reset (manual recovery).
      save_tracked "$rdir" && g reset -q --hard "$PRE"
    fi
  fi
  [ "${1:-}" = nokeep ] || keep_restore
  if [ "$(g symbolic-ref -q HEAD)" != "refs/heads/$B" ] || [ "$(g rev-parse HEAD)" != "$PRE" ] \
    || g rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 || [ -n "$(g ls-files -u)" ]; then
    RESULT="failed:NEEDS-MANUAL-RECOVERY (PRE=$PRE${STASH_SHA:+ STASH_SHA=$STASH_SHA})"
  fi
}

claude_ok() { [ -n "$CLAUDE_BIN" ] && [ -n "$TO" ]; }

FORBIDDEN='git commit, git merge (including --continue and --abort), git reset, git checkout, git switch,
git restore, git stash, git rebase, git pull, git push, git add, git rm, git clean, git branch'

# prompt_conflicts / prompt_rules: the parts shared by both §8.1 and §8.2 prompts.
prompt_conflicts() {
  echo "Conflicted files (git status --porcelain code, then path):"
  g status --porcelain -z --untracked-files=no | tr '\0' '\n' | grep -E '^(DD|AU|UD|UA|DU|AA|UU) '
}
prompt_rules() {
  cat <<EOP

Rules:
- Edit only the conflicted files listed above.
- Modify/delete conflict: either delete the file or keep the modified version.
- Binary file: pick one side with \`git show :2:<path>\` (ours) or \`git show :3:<path>\` (theirs).
- Read-only git commands and builds/tests are allowed.
Do not run any of these git commands:
$FORBIDDEN

Edit the files in place and exit; do not stage or commit.
EOP
}

# write_merge_prompt FILE: §8.1 prompt.
write_merge_prompt() {
  local base
  base=$(g merge-base HEAD MERGE_HEAD)
  {
    echo "Repository: $REPO_DIR"
    echo "Branch: $B"
    echo
    echo "You are resolving a merge of origin/$B (theirs, remote) into local $B (ours)."
    echo "Keep the intent of both sides."
    echo
    prompt_conflicts
    echo
    echo "Local commits (git log --oneline -20 $base..HEAD):"
    g log --no-color --oneline -20 "$base..HEAD"
    echo
    echo "Remote commits (git log --oneline -20 $base..MERGE_HEAD):"
    g log --no-color --oneline -20 "$base..MERGE_HEAD"
    prompt_rules
  } >"$1"
}

# write_stash_prompt FILE: §8.2 prompt.
write_stash_prompt() {
  {
    echo "Repository: $REPO_DIR"
    echo "Branch: $B"
    echo
    echo "You are re-applying the user's uncommitted local changes (the \`Stashed changes\` side, from stash $STASH_SHA)" \
      "on top of the updated branch (the \`Updated upstream\` side = HEAD, which already contains the remote changes)." \
      "Preserve the user's local edits while keeping the upstream changes."
    echo
    prompt_conflicts
    echo
    echo "Upstream commits (git log --oneline -20 $STASH_SHA^1..HEAD):"
    g log --no-color --oneline -20 "$STASH_SHA^1..HEAD"
    prompt_rules
  } >"$1"
}

# snapshot_state FILE: what claude must not change, one "<check> <value>" line each; untracked list in FILE.u.
snapshot_state() {
  {
    echo "HEAD $(g rev-parse -q --verify HEAD)"
    echo "MERGE_HEAD $(g rev-parse -q --verify MERGE_HEAD)"
    echo "branch $(g symbolic-ref -q HEAD)"
    echo "stash $(g stash list --format=%H | cksum)"
    echo "index $(g ls-files -s | cksum)"
    echo "config $(cksum <"$(gpath config)")"
    echo "hooks $(hooks_sum)"
  } >"$1"
  untracked >"$1.u"
}

# hooks_sum: digest of the effective hooks dir (honours core.hooksPath): its path, listing (names, modes) and contents.
hooks_sum() {
  local h
  h=$(gpath hooks)
  { echo "$h"; ls -lAR "$h"; find "$h" -type f -exec cat {} +; } 2>&1 | cksum
}

# subset FILE: every non-empty stdin line occurs in FILE (FILE may be empty, hence no NR == FNR).
subset() { LC_ALL=C awk 'FILENAME == ARGV[1] { S[$0] = 1; next } $0 != "" && !($0 in S) { exit 1 }' "$1" -; }

# verify_state KIND BEFORE CONFLICTS: echo the first failed check (nothing if all hold).
# CONFLICTS = the conflicted set as zhex lines.
verify_state() {
  local a=$TMPD/after bad
  snapshot_state "$a"
  bad=$(LC_ALL=C awk 'NR == FNR { v[FNR] = $0; next } $0 != v[FNR] { print $1; exit }' "$2" "$a")
  if [ -z "$bad" ] && [ "$1" = merge ] && [ "$(g rev-parse -q --verify MERGE_HEAD)" != "$RS" ]; then bad=MERGE_HEAD; fi
  if [ -z "$bad" ] && ! g diff -z --name-only | zhex | subset "$3"; then bad=worktree; fi
  if [ -z "$bad" ] && ! subset "$2.u" <"$a.u"; then bad=untracked; fi
  echo "$bad"
}

# marker_check PATHFILE: 1 if an added line in the staged diff of any (NUL-delimited) path is a conflict marker.
# ======= never counts (setext headings); binary paths are skipped.
marker_check() {
  local p
  while IFS= read -r -d '' p; do
    case $(g --literal-pathspecs diff --cached --numstat HEAD -- "$p") in -*) continue ;; esac
    g --literal-pathspecs diff --cached --no-color --no-ext-diff --no-textconv HEAD -U0 -- "$p" \
      | grep -Eq '^\+(<<<<<<<|>>>>>>>|\|\|\|\|\|\|\|)( |$)' && return 1
  done <"$1"
  return 0
}

# claude_undo KIND: undo after a failed resolve (RESULT set). stash: unstage, restore without step 4 (§8.2).
claude_undo() {
  if [ "$1" = stash ]; then
    g reset -q
    RESULT="failed:keep-restore (changes in $STASH_SHA)"
    restore nokeep
  else
    restore
  fi
}

# claude_resolve merge|stash: §8.1/§8.2. 0 resolved (merge: committed; stash: unstaged), 1 failed (RESULT set, undone).
claude_resolve() {
  local kind=$1 c=$TMPD/conflicts bad p staged
  if ! claude_ok; then RESULT=failed:claude-unavailable; claude_undo "$kind"; return 1; fi
  g diff -z --name-only --diff-filter=U >"$c.z"
  zhex <"$c.z" | LC_ALL=C sort >"$c"
  "write_${kind}_prompt" "$TMPD/prompt"
  snapshot_state "$TMPD/before"
  # shellcheck disable=SC2016  # $1/$@ expand in the child sh
  run_child "$TMPD/prompt" sh -c 'cd "$1" && shift && exec "$@"' _ "$REPO_DIR" \
    env -u CLAUDECODE GIT_ALLOW_PROTOCOL=none \
    "$TO" -k 30 "${REPOSYNC_CLAUDE_TIMEOUT:-900}" "$CLAUDE_BIN" -p --dangerously-skip-permissions
  if [ "$RC" = 124 ] || [ "$RC" = 137 ]; then RESULT=failed:claude-timeout
  elif [ "$RC" != 0 ]; then RESULT="failed:claude (rc=$RC)"
  elif bad=$(verify_state "$kind" "$TMPD/before" "$c") && [ -n "$bad" ]; then
    RESULT="failed:claude-modified-git-state: $bad"
  else
    while IFS= read -r -d '' p; do g --literal-pathspecs add -A -- "$p"; done <"$c.z"
    if [ -n "$(g ls-files -u)" ] || ! marker_check "$c.z"; then RESULT=failed:merge-conflict-unresolved
    elif [ "$kind" = stash ]; then g reset -q; return 0
    elif ! staged=$(g write-tree); then RESULT=failed:merge
    elif ! g commit -q --no-edit; then RESULT=failed:merge
    elif [ "$(g rev-parse "HEAD^{tree}")" != "$staged" ]; then RESULT="failed:claude-modified-git-state: commit-tree"
    elif [ "$(g rev-list --parents -n1 HEAD)" != "$(g rev-parse HEAD) $PRE $RS" ]; then RESULT=failed:ancestry
    else return 0
    fi
  fi
  claude_undo "$kind"
  return 1
}
# Task 5 implements §7.6 step 4.
keep_restore() { :; }

leftover_warnings() {
  local line re='^On [^:]*: reposync-keep '
  while IFS= read -r line; do
    [[ ${line#* } =~ $re ]] || continue
    echo "WARN $REPO_NAME: leftover reposync stash ${line%% *}"
    FAILED=1
  done <<EOL
$(g stash list --format='%H %s' 2>/dev/null)
EOL
}

# sync_repo: §7 for one repo (REPO_DIR set, is a repo); sets RESULT.
sync_repo() {
  local reason
  B=$(g symbolic-ref -q --short HEAD 2>/dev/null)
  R=refs/remotes/origin/$B
  reason=$(skip_reason)
  if [ -n "$reason" ]; then RESULT=skipped:$reason; return; fi
  PRE=$(g rev-parse HEAD)
  g rev-parse -q --verify "$R" >/dev/null 2>&1 && HAD_R=1
  fetch_repo || return
  classify || return
  if [ "$DRY_RUN" = 1 ]; then
    case $STATE in
      ahead) ACTIONS=pushed ;;
      behind) ACTIONS=merged ;;
      diverged) ACTIONS=merged+pushed ;;
      no-upstream) ACTIONS=set-upstream+pushed ;;
    esac
    RESULT=ok
    return
  fi
  # >>> Task 5 hook: --dirty=commit|keep handling runs here (after classify, before the guard).
  # No-op for --dirty=skip (dirty repos were skipped) and clean trees.
  case $STATE in
    behind|diverged) { ignored_guard && assert_clean_and_snap && do_merge; } || return ;;
  esac
  case $STATE in
    ahead|diverged) do_push || return ;;
    no-upstream) do_push -u || return ;;
  esac
  RESULT=ok
  keep_restore
}

process_repo() {
  reset_repo_state
  REPO_DIR=$1 REPO_NAME=${1##*/}
  if ! is_repo; then emit_row skipped:not-git; return; fi
  IN_REPO=1
  sync_repo
  IN_REPO=0
  emit_row "$RESULT${NOTE:+ ($NOTE)}"
  leftover_warnings
}

# on_signal CODE: §9. Stop the child, restore the in-progress repo (never calls claude), report, exit CODE.
on_signal() {
  trap '' INT TERM HUP
  if [ -n "$CHILD" ]; then kill -TERM "$CHILD" 2>/dev/null; wait "$CHILD"; CHILD=""; fi
  FROM_SIGNAL=1
  if [ "$IN_REPO" = 1 ]; then
    RESULT=failed:interrupted
    restore
    emit_row "$RESULT${NOTE:+ ($NOTE)}"
  fi
  exit "$1"
}

trap 'release_lock; rm -rf "$TMPD"' EXIT
trap 'on_signal 130' INT
trap 'on_signal 143' TERM HUP

main() {
  parse_args "$@"
  resolve_workspace
  acquire_lock
  local d
  for d in "$WS"/*/; do
    [ -d "$d" ] && process_repo "${d%/}"
  done
  exit "$FAILED"
}

main "$@"
